log_format privacy '$remote_addr $request_method $uri $status $body_bytes_sent';
access_log /dev/stdout privacy;
server_tokens off;

server {
    listen 80;
    server_name ${SITE_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://${SITE_DOMAIN}:${HTTPS_PORT}$request_uri; }
}

server {
    listen 443 ssl;
    server_name ${SITE_DOMAIN};
    ssl_certificate /etc/letsencrypt/active/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/active/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;

    location = /healthz { access_log off; return 200 'ok'; }
    location /static/ {
        alias /srv/static/;
        add_header X-Content-Type-Options nosniff always;
    }
    location /media/ {
        alias /srv/media/;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
    }
    location / {
        # Docker DNS is resolved again after web container recreation.
        resolver 127.0.0.11 valid=10s;
        set $django_upstream web:8000;
        proxy_pass http://$django_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect off;
        proxy_read_timeout 65s;
    }
}
