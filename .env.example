DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=cleaning_service
POSTGRES_USER=cleaning_service
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Docker only: independent cluster, never publish its port.
POSTGRES_ADMIN_PASSWORD=
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_DOMAIN=localhost
TLS_MODE=local
ACME_EMAIL=
GUNICORN_WORKERS=2
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
# Compose enables these; runserver defaults remain HTTP.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# For production email; no SMTP service is included.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost
